{
  "expo": {
    "name": "cutmer",
    "slug": "cutmer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cutmer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "me.fairygel.cutmer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "me.fairygel.cutmer"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Andika",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Andika-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Andika-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Andika-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Andika-BoldItalic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Andika-Regular.ttf",
              "./assets/fonts/Andika-Italic.ttf",
              "./assets/fonts/Andika-Bold.ttf",
              "./assets/fonts/Andika-BoldItalic.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "768789a2-145d-4fbf-9914-75ef5afd4e42"
      }
    }
  }
}
